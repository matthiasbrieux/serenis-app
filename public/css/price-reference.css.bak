/* Only the new read-only block in lesson 1.1. */
body.vpm-formation-page #step-0-0 .price-reference {
  margin:20px 0;padding:20px;border:1px solid rgba(158,58,24,.18);border-radius:10px;
  background:var(--cream,#FCF7F0);color:#302A26;font-family:inherit;line-height:1.6;
}
body.vpm-formation-page #step-0-0 .price-reference h3 {margin:0 0 12px;color:var(--terracotta,#9E3A18);font-family:inherit;font-size:1.15rem;line-height:1.4;}
body.vpm-formation-page #step-0-0 .price-reference p {margin:8px 0;overflow-wrap:anywhere;}
body.vpm-formation-page #step-0-0 .price-reference .price-reference-note {font-size:.85rem;line-height:1.6;margin-top:14px;}
@media(max-width:640px){body.vpm-formation-page #step-0-0 .price-reference{padding:16px;}}

/* ══ Tableau premium des ventes comparables — leçon 1.2 ══ */
[data-price-comparables] { margin: 20px 0; }
[data-price-comparables][aria-busy="true"] { color: #7A6B60; font-size: .9rem; font-family: "DM Sans", sans-serif; }

.pr-comp-wrap {
  font-family: "DM Sans", sans-serif;
  background: #FDF9F5;
  border: 1px solid rgba(158,58,24,.18);
  border-radius: 14px;
  overflow: hidden;
  width: 100%;
  color: #302A26;
}
.pr-comp-empty {
  padding: 24px 28px;
  color: #7A6B60;
  font-size: .9rem;
  margin: 0;
}

/* Header */
.pr-comp-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 24px 28px 20px;
  flex-wrap: wrap;
}
.pr-comp-header-left {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  flex: 1;
  min-width: 0;
}
.pr-comp-icon-box {
  flex-shrink: 0;
  width: 50px;
  height: 50px;
  background: rgba(158,58,24,.1);
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9E3A18;
}
.pr-comp-header-text { min-width: 0; }
.pr-comp-title {
  margin: 0 0 4px;
  font-size: 1.3rem;
  font-weight: 700;
  color: #9E3A18;
  line-height: 1.3;
  font-family: "DM Sans", sans-serif;
}
.pr-comp-sub {
  margin: 0;
  font-size: .875rem;
  color: #6B5E54;
  line-height: 1.5;
}

/* Count badge */
.pr-count-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(158,58,24,.07);
  border: 1px solid rgba(158,58,24,.2);
  border-radius: 10px;
  padding: 10px 14px;
}
.pr-count-icon { color: #9E3A18; flex-shrink: 0; display: flex; align-items: center; }
.pr-count-num {
  display: block;
  font-size: .875rem;
  font-weight: 700;
  color: #9E3A18;
  line-height: 1.3;
  white-space: nowrap;
}
.pr-count-radius {
  display: block;
  font-size: .78rem;
  color: #7A6B60;
  line-height: 1.3;
  white-space: nowrap;
}

/* Address note */
.pr-addr-note {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin: 0 28px 16px;
  font-size: .78rem;
  color: #7A6B60;
  background: rgba(158,58,24,.05);
  border-left: 3px solid rgba(158,58,24,.3);
  padding: 8px 12px;
  border-radius: 0 6px 6px 0;
  line-height: 1.55;
}
.pr-addr-note svg { flex-shrink: 0; margin-top: 1px; color: #9E3A18; }

/* Desktop table */
.pr-desktop-table { margin: 0 28px 20px; }
.pr-desktop-table .pr-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 10px;
  border: 1px solid rgba(158,58,24,.12);
}
.pr-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .865rem;
  font-family: "DM Sans", sans-serif;
  background: #fff;
  min-width: 580px;
}
.pr-table thead tr { background: #F5EDE5; }
.pr-table th {
  padding: 11px 14px;
  text-align: left;
  color: #302A26;
  font-weight: 600;
  font-size: .78rem;
  white-space: nowrap;
}
.pr-th-icon { width: 40px; padding: 11px 6px 11px 14px !important; }
.pr-th-icon-cell {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.pr-th-icon-cell svg { color: #9E3A18; flex-shrink: 0; }
.pr-table tbody tr { border-top: 1px solid #F0E8E0; transition: background .12s; }
.pr-table tbody tr:nth-child(even) { background: #FDFAF7; }
.pr-table tbody tr:hover { background: #FAF0E8; }
.pr-table td { padding: 12px 14px; vertical-align: middle; color: #302A26; }
.pr-td-icon-cell { padding: 12px 6px 12px 14px !important; }
.pr-row-icon {
  width: 30px;
  height: 30px;
  background: rgba(158,58,24,.08);
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9E3A18;
}
.pr-addr-street {
  display: block;
  font-weight: 600;
  color: #1A1A16;
  line-height: 1.4;
}
.pr-addr-locality {
  display: block;
  font-size: .78rem;
  color: #7A6B60;
  line-height: 1.35;
  margin-top: 1px;
}
.pr-addr-comm-tag {
  font-size: .72rem;
  color: #9A8B80;
  font-style: italic;
  font-weight: 400;
  margin-left: 4px;
}
.pr-na-addr {
  color: #BBB;
  font-style: italic;
  font-size: .82rem;
}
.pr-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.pr-ratio-val {
  font-weight: 700;
  color: #9E3A18;
  white-space: nowrap;
  font-size: .9rem;
}
.pr-dist-pill {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  background: #F5EDE5;
  border: 1px solid rgba(158,58,24,.15);
  border-radius: 20px;
  padding: 3px 8px;
  font-size: .8rem;
  color: #5A4A40;
  white-space: nowrap;
}
.pr-dist-pill svg { color: #9E3A18; flex-shrink: 0; }

/* Mobile cards */
.pr-mobile-cards {
  display: none;
  flex-direction: column;
  gap: 10px;
  margin: 0 16px 20px;
}
.pr-card {
  background: #fff;
  border: 1px solid rgba(158,58,24,.12);
  border-radius: 10px;
  padding: 14px 16px;
}
.pr-card-head {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 12px;
}
.pr-card-icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  background: rgba(158,58,24,.08);
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9E3A18;
  margin-top: 1px;
}
.pr-card-street {
  display: block;
  font-weight: 600;
  color: #1A1A16;
  font-size: .88rem;
  line-height: 1.4;
}
.pr-card-locality {
  display: block;
  font-size: .78rem;
  color: #7A6B60;
  line-height: 1.35;
}
.pr-card-comm-tag {
  font-size: .72rem;
  color: #9A8B80;
  font-style: italic;
  font-weight: 400;
}
.pr-card-data {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 16px;
}
.pr-card-dist-row { grid-column: 1 / -1; }
.pr-card-row { display: flex; flex-direction: column; gap: 1px; }
.pr-card-label {
  font-size: .68rem;
  color: #9A8B80;
  text-transform: uppercase;
  letter-spacing: .04em;
  font-weight: 600;
}
.pr-card-val {
  font-size: .88rem;
  color: #302A26;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.pr-card-ratio {
  font-size: .95rem;
  color: #9E3A18;
  font-weight: 700;
}

/* Calculation box */
.pr-calc-box {
  display: flex;
  align-items: stretch;
  margin: 0 28px 20px;
  border: 1px solid rgba(158,58,24,.18);
  border-radius: 10px;
  overflow: hidden;
  background: #fff;
}
.pr-calc-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  padding: 16px 18px;
  background: rgba(158,58,24,.08);
  min-width: 155px;
  max-width: 170px;
  flex-shrink: 0;
}
.pr-calc-icon { color: #9E3A18; display: flex; }
.pr-calc-title {
  font-size: .8rem;
  font-weight: 700;
  color: #9E3A18;
  line-height: 1.4;
}
.pr-calc-formula {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 16px 20px;
  flex: 1;
  flex-wrap: wrap;
}
.pr-calc-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  text-align: center;
}
.pr-calc-label {
  font-size: .72rem;
  color: #7A6B60;
  line-height: 1.35;
  text-align: center;
}
.pr-calc-val {
  font-size: .95rem;
  font-weight: 700;
  color: #302A26;
  font-variant-numeric: tabular-nums;
}
.pr-calc-result {
  font-size: 1.2rem;
  font-weight: 700;
  color: #9E3A18;
  font-variant-numeric: tabular-nums;
}
.pr-calc-op {
  font-size: 1.3rem;
  color: #B09080;
  font-weight: 300;
  flex-shrink: 0;
  line-height: 1;
  padding-top: 14px;
}
.pr-calc-note {
  font-size: .72rem;
  color: #9A8B80;
  margin: 0 28px 18px;
  font-style: italic;
  line-height: 1.5;
}

/* Footer disclaimer */
.pr-comp-footer {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 0 28px 24px;
  padding: 12px 14px;
  background: rgba(158,58,24,.05);
  border-radius: 8px;
  border: 1px solid rgba(158,58,24,.1);
}
.pr-footer-icon {
  flex-shrink: 0;
  color: #9E3A18;
  display: flex;
  align-items: center;
  margin-top: 1px;
}
.pr-comp-footer p {
  margin: 0;
  font-size: .8rem;
  color: #6B5E54;
  line-height: 1.65;
}

/* Responsive */
@media (max-width: 640px) {
  .pr-comp-header { padding: 16px 16px 14px; gap: 12px; }
  .pr-comp-icon-box { width: 42px; height: 42px; }
  .pr-comp-title { font-size: 1.05rem; }
  .pr-count-badge { width: 100%; }
  .pr-addr-note { margin: 0 16px 14px; }
  .pr-desktop-table { display: none; }
  .pr-mobile-cards { display: flex; }
  .pr-calc-box { flex-direction: column; margin: 0 16px 16px; }
  .pr-calc-left { min-width: unset; max-width: unset; flex-direction: row; align-items: center; gap: 10px; }
  .pr-calc-formula { gap: 8px; padding: 14px 16px; }
  .pr-calc-op { padding-top: 12px; }
  .pr-calc-note { margin: 0 16px 16px; }
  .pr-comp-footer { margin: 0 16px 20px; }
}

/* ══ Tableau de bord résumé — leçon 1.1 ══ */
.pr-summary-wrap { font-family: "DM Sans", sans-serif; }
.pr-summary-msg { margin: 0; color: #7A6B60; font-size: .9rem; line-height: 1.6; }
.pr-summary-context {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding-bottom: 14px;
  margin-bottom: 14px;
  border-bottom: 1px solid rgba(158,58,24,.12);
}
.pr-summary-ctx-item { display: flex; flex-direction: column; gap: 3px; }
.pr-summary-ctx-label {
  font-size: .68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .05em;
  color: #9A8B80;
}
.pr-summary-ctx-val {
  font-size: .88rem;
  color: #302A26;
  font-weight: 500;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.pr-summary-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.pr-summary-metric {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 12px 14px;
  border: 1px solid rgba(158,58,24,.12);
  border-radius: 9px;
  background: #fff;
}
.pr-summary-metric-main {
  border-color: rgba(158,58,24,.25);
  background: rgba(158,58,24,.05);
}
.pr-summary-metric-full { grid-column: 1 / -1; }
.pr-summary-metric-label {
  font-size: .68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: #9A8B80;
  line-height: 1.4;
}
.pr-summary-metric-val {
  font-size: .9rem;
  font-weight: 600;
  color: #302A26;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}
.pr-summary-metric-val-main {
  font-size: 1.15rem;
  font-weight: 700;
  color: #9E3A18;
}
@media (max-width: 640px) {
  .pr-summary-context { grid-template-columns: 1fr; }
  .pr-summary-metrics { grid-template-columns: 1fr; }
}

/* ══ Trois repères de prix — leçon 1.1 ══ */
.pr-bench-wrap {
  font-family: "DM Sans", sans-serif;
  background: #FDF9F5;
  border: 1px solid rgba(158,58,24,.18);
  border-radius: 14px;
  overflow: hidden;
  color: #302A26;
  margin-top: 14px;
}
.pr-bench-header {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 20px 24px 16px;
  border-bottom: 1px solid rgba(158,58,24,.1);
}
.pr-bench-icon-box {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  background: rgba(158,58,24,.1);
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9E3A18;
}
.pr-bench-header-text { min-width: 0; }
.pr-bench-title {
  margin: 0 0 4px;
  font-size: 1.2rem;
  font-weight: 700;
  color: #9E3A18;
  line-height: 1.3;
  font-family: "DM Sans", sans-serif;
}
.pr-bench-sub {
  margin: 0;
  font-size: .82rem;
  color: #6B5E54;
  line-height: 1.55;
}
.pr-bench-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  padding: 20px 24px 24px;
}
.pr-bench-card {
  background: #fff;
  border: 1px solid rgba(158,58,24,.15);
  border-radius: 12px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.pr-bench-card-hdr {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.pr-bench-card-icon {
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9E3A18;
  margin-top: 1px;
}
.pr-bench-icon-low { background: rgba(158,58,24,.08); }
.pr-bench-icon-mid { background: rgba(158,58,24,.12); }
.pr-bench-icon-high { background: rgba(158,58,24,.08); }
.pr-bench-card-lbl {
  font-size: .78rem;
  font-weight: 600;
  color: #7A6B60;
  line-height: 1.4;
}
.pr-bench-card-pm2 {
  font-size: 1.5rem;
  font-weight: 700;
  color: #9E3A18;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.pr-bench-card-indic {
  border-top: 1px solid rgba(158,58,24,.1);
  padding-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.pr-bench-card-indic-lbl {
  font-size: .74rem;
  color: #9A8B80;
  line-height: 1.4;
}
.pr-bench-card-indic-val {
  font-size: 1.1rem;
  font-weight: 700;
  color: #302A26;
  font-variant-numeric: tabular-nums;
}
@media (max-width: 700px) {
  .pr-bench-header { padding: 16px; }
  .pr-bench-cards { grid-template-columns: 1fr; padding: 16px; gap: 10px; }
  .pr-bench-card-pm2 { font-size: 1.25rem; }
}

/* ══ Déterminez votre prix de vente — leçon 1.3 ══ */
.pt-wrap {
  font-family: "DM Sans", sans-serif;
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 16px;
}
.pt-bloc {
  background: #FDF9F5;
  border: 1px solid rgba(158,58,24,.15);
  border-radius: 14px;
  overflow: hidden;
}
.pt-bloc-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  background: rgba(158,58,24,.04);
  border-bottom: 1px solid rgba(158,58,24,.1);
}
.pt-bloc-num {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #9E3A18;
  color: #fff;
  font-size: 0.78rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pt-bloc-title {
  margin: 0;
  font-size: 0.9rem;
  font-weight: 600;
  color: #302A26;
}
/* Bloc 1 — indisponible */
.pt-unavail {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 18px;
  color: #7A6A5E;
}
.pt-unavail svg { flex-shrink: 0; opacity: 0.6; }
.pt-unavail-msg { font-size: 0.88rem; font-style: italic; }
/* Bloc 2 — table */
.pt-table-wrap { padding: 16px 18px; overflow-x: auto; }
.pt-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
  color: #302A26;
}
.pt-table thead th {
  text-align: left;
  padding: 7px 12px;
  background: rgba(158,58,24,.06);
  font-weight: 600;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  color: #7A5040;
  border-bottom: 1px solid rgba(158,58,24,.12);
}
.pt-table tbody td {
  padding: 9px 12px;
  border-bottom: 1px solid rgba(0,0,0,.05);
  vertical-align: middle;
}
.pt-table tbody tr:last-child td { border-bottom: 0; }
.pt-table tbody tr:hover td { background: rgba(158,58,24,.03); }
.pt-na { color: #A0907E; font-style: italic; font-size: 0.83rem; }
/* Bloc 3 — calcul indisponible */
.pt-calc-na-wrap { padding: 14px 18px; }
.pt-calc-na {
  font-size: 0.85rem;
  color: #7A6A5E;
  font-style: italic;
  margin: 0;
  padding: 10px 14px;
  background: rgba(0,0,0,.03);
  border-left: 3px solid rgba(158,58,24,.25);
  border-radius: 0 8px 8px 0;
}
/* Bloc 4 — prix souhaité */
.pt-price-input-wrap { padding: 16px 18px 12px; }
.pt-price-label {
  display: block;
  font-size: 0.84rem;
  font-weight: 500;
  color: #302A26;
  margin-bottom: 10px;
}
.pt-price-field {
  display: flex;
  align-items: center;
  gap: 8px;
  max-width: 240px;
}
.pt-price-input {
  flex: 1;
  padding: 10px 14px;
  border: 1.5px solid rgba(158,58,24,.35);
  border-radius: 8px;
  font-size: 1rem;
  font-family: "DM Sans", sans-serif;
  font-variant-numeric: tabular-nums;
  color: #302A26;
  background: #fff;
  outline: none;
  transition: border-color .18s;
  -moz-appearance: textfield;
}
.pt-price-input::-webkit-outer-spin-button,
.pt-price-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.pt-price-input:focus { border-color: #9E3A18; box-shadow: 0 0 0 3px rgba(158,58,24,.08); }
.pt-price-currency { font-size: 1rem; font-weight: 600; color: #7A5040; }
.pt-save-status {
  display: block;
  margin-top: 6px;
  font-size: 0.78rem;
  min-height: 1.2em;
}
.pt-save-saving { color: #7A6A5E; }
.pt-save-ok { color: #2D6A4F; font-weight: 600; }
.pt-save-error { color: #9E3A18; }
.pt-formula-wrap {
  margin: 12px 18px 16px;
  padding: 12px 14px;
  background: rgba(158,58,24,.05);
  border: 1px solid rgba(158,58,24,.12);
  border-radius: 10px;
}
.pt-formula-title {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #7A5040;
  margin-bottom: 8px;
}
.pt-formula-na { font-size: 0.84rem; color: #7A6A5E; font-style: italic; }
/* Bloc 5 — conseils */
.pt-advice-grid {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 14px 18px 16px;
}
.pt-advice-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 13px 15px;
  border-radius: 10px;
  font-size: 0.86rem;
  line-height: 1.6;
}
.pt-advice-card strong { display: block; margin-bottom: 3px; font-weight: 600; }
.pt-advice-card p { margin: 0; }
.pt-advice-icon { flex-shrink: 0; padding-top: 1px; }
.pt-advice-green {
  background: rgba(45,106,79,.07);
  border: 1px solid rgba(45,106,79,.2);
  color: #1E4434;
}
.pt-advice-green .pt-advice-icon svg { stroke: #2D6A4F; }
.pt-advice-info {
  background: rgba(30,72,145,.06);
  border: 1px solid rgba(30,72,145,.18);
  color: #1A3A6E;
}
.pt-advice-info .pt-advice-icon svg { stroke: #1E4891; }
.pt-advice-warn {
  background: rgba(158,58,24,.06);
  border: 1px solid rgba(158,58,24,.18);
  color: #5A2A14;
}
.pt-advice-warn .pt-advice-icon svg { stroke: #9E3A18; }
@media (max-width: 640px) {
  .pt-bloc-header { padding: 12px 14px; }
  .pt-unavail { padding: 14px; }
  .pt-table-wrap { padding: 12px 14px; }
  .pt-price-input-wrap { padding: 14px 14px 10px; }
  .pt-formula-wrap { margin: 10px 14px 14px; }
  .pt-advice-grid { padding: 12px 14px 14px; }
}
